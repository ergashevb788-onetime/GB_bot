# Copy this file to .env and fill in your values
# Never commit the real .env to git

# Your bot token from @BotFather
BOT_TOKEN=8771664798:AAFXgDDLQlrOwfAoZ-e4D67I8LtMJLe_Ddw

# Your personal Telegram chat ID (get it from @userinfobot)
OWNER_CHAT_ID=2071547068

# Your Render app URL (leave empty for local polling mode)
# Example: https://cozy-productivity-bot.onrender.com
WEBHOOK_URL=

# Port (Render uses 10000; leave 8080 for local dev)
PORT=8080

# PostgreSQL connection string
# On Render: this is auto-injected from the linked database — you don't need to set it manually
# For local dev: use your local PostgreSQL or a free cloud DB (e.g. Supabase, Neon)
# Format: postgresql://user:password@host:port/dbname
DATABASE_URL=postgresql://user:password@localhost:5432/cozybot
